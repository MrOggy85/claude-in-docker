# Linux systemd --user equivalent of com.user.claude-sound-server.plist (macOS).
# Assumes the repo lives at ~/code/claude-in-docker; edit ExecStart if yours differs.
# Install: cp to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now claude-sound-server
# Logs: journalctl --user -u claude-sound-server -f
[Unit]
Description=Claude sound server (see docs/sound-effects.md)

[Service]
ExecStart=%h/code/claude-in-docker/sound-effects/host-sound-server.sh
Restart=always

[Install]
WantedBy=default.target
