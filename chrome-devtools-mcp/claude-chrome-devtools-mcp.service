# Linux systemd --user equivalent of com.user.claude-chrome-devtools-mcp.plist (macOS).
# Assumes the repo lives at ~/code/claude-in-docker; edit ExecStart if yours differs.
# Install: cp to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now claude-chrome-devtools-mcp
# Logs: journalctl --user -u claude-chrome-devtools-mcp -f
[Unit]
Description=Claude chrome-devtools-mcp bridge (see docs/chrome-devtools-mcp.md)

[Service]
ExecStart=%h/code/claude-in-docker/chrome-devtools-mcp/host-chrome-devtools-mcp.sh
Restart=always

[Install]
WantedBy=default.target
