#!/usr/bin/env bash
#
# cid — inspect and edit the claude-in-docker (CID) configuration.
#
# All user config lives OUTSIDE this repo, in a dedicated dir
# (~/.config/claude-in-docker by default; see scripts/paths.sh). The inspection
# commands (list/show/project/domains/containers) are read-only viewers; the
# `domains add|rm` and `containers add|rm` commands edit the allowlists in place
# so you don't have to open the files by hand.
#
# Usage:
#   cid [list]                 Show the config dir and every global config file
#                              (present / missing), plus the projects dir.
#   cid show <file>            Print a global config file (e.g. settings.json,
#                              allowed-domains.txt). Credentials are never dumped.
#   cid project [dir]          Show the per-project key + config dir for a project
#                              (default: current dir) and which overrides exist.
#   cid domains [dir]          Show the effective egress allowlist for a project:
#                              the baseline plus any per-project additions.
#   cid domains add <host>...  Add host(s) to the per-project allowlist (default)
#                              or, with -g, the shared baseline list.
#   cid domains add --for <dur> <host>...
#                              Same, but the entry expires after <dur> (e.g. 15m,
#                              2h, 1d) — the proxy stops honoring it once it's
#                              passed. Re-adding refreshes the expiry; a plain
#                              add (no --for) on a temporary entry makes it
#                              permanent.
#   cid domains rm  <host>...  Remove host(s) from the per-project allowlist
#                              (default) or, with -g, the shared baseline list.
#   cid domains prune          Drop expired --for entries from the list (hygiene
#                              only — the proxy already ignores them).
#   cid splice [dir]           Show which hosts the proxy tunnels WITHOUT
#                              decrypting TLS (baseline + per-project).
#   cid splice add <host>...   Stop decrypting a host — for a client that pins
#                              certificates (-g: baseline).
#   cid splice rm  <host>...   Decrypt it again (-g: baseline).
#   cid ca                     Show the egress CA the proxy signs intercepted TLS
#                              with: path, expiry, fingerprint, image copy status.
#   cid containers [dir]       Show which Docker containers the host docker bridge
#                              may inspect for a project (baseline + per-project).
#   cid containers add <name>… Allow container(s) for this project (-g: baseline).
#   cid containers rm  <name>… Disallow container(s) (-g: baseline).
#   cid settings [dir]         Show what a project's .claude/settings*.json actually
#                              grants (same scan guards/project-settings.sh runs) and
#                              whether the guard will prompt about it.
#   cid settings trust <rule>… Stop flagging a permissions.allow rule (-g: baseline).
#   cid settings untrust <rule>… Flag it again.
#   cid settings forget        Drop the approved risk profile for a project.
#   cid env [filter]           List the environment variables you can set on the
#                              host, with current value / default (optional name
#                              filter). A terminal mirror of docs/environment-variables.md.
#   cid help                   This help.
#
# domains|splice|containers add|rm flags:
#   -g, --global               Target the shared baseline list instead of the
#                              current project's per-project list.
#   -C, --dir <dir>            Select the project by directory (default: PWD).
#                              Ignored with -g (the baseline is not per-project).
#   --for <duration>           domains add only: expire the entry after
#                              <duration> (digits + optional s/m/h/d suffix).
#
# The domain and splice lists are read live by the Squid proxy (2s cache), so
# add/rm take effect within ~2s — no image rebuild or proxy restart. The container
# allowlist is read per bridge call, so it applies immediately. See docs/config-cli.md.

set -euo pipefail

# Resolve symlinks so `cid` finds its sibling scripts/ when linked onto $PATH
# (e.g. ~/.local/bin/cid -> repo/cid). Portable across BSD/macOS + GNU readlink.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
  _dir="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${_dir}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
source "${SCRIPT_DIR}/scripts/paths.sh"

CONFIG_DIR="$(config_dir)"
PROJECTS_DIR="$(projects_dir)"
TEMPLATES_DIR="${SCRIPT_DIR}/templates"

# Global config files run.sh mounts from the config dir, with a one-line note.
# (install_additional_packages.sh is deliberately absent: it is baked into the
#  image at build time, so it lives in the repo, not the config dir — see below.)
GLOBAL_FILES=(
  "settings.json|Claude Code settings mounted at ~/.claude/settings.json"
  "claude.json|Onboarding state + user-level config (mounted read-write)"
  "mcp-servers.json|MCP server definitions, injected via --mcp-config"
  "container-CLAUDE.md|Personal instructions mounted at ~/.claude/CLAUDE.md"
  ".gitconfig|git user.name / user.email"
  ".gitignore_global|Global gitignore mounted at ~/.config/git/ignore"
  ".credentials.json|Claude auth token (secret; not printed by 'show')"
  "allowed-domains.txt|Baseline egress allowlist enforced by the Squid proxy"
  "splice-domains.txt|Hosts the proxy tunnels WITHOUT decrypting TLS (bump exceptions)"
  "docker-containers.txt|Baseline container allowlist for the docker bridge (optional)"
  "trusted-settings-rules.txt|permissions.allow rules the settings guard should not flag (optional)"
  ".env|Arbitrary KEY=VALUE env vars injected via --env-file"
)

err()  { printf '%s\n' "$*" >&2; }
note() { printf '>> %s\n' "$*"; }
head_() { printf '\n== %s ==\n' "$*"; }

# Is the named env var currently set (even if empty)? Portable to bash 3.2
# (macOS's /bin/bash), which lacks `[[ -v name ]]`. The name comes from our own
# vetted ENV_VARS list, so the eval is safe.
_is_set() { eval "[ \"\${${1}+x}\" = x ]"; }

cmd_list() {
  head_ "Config directory"
  printf '  %s' "${CONFIG_DIR}"
  [[ -d "${CONFIG_DIR}" ]] || printf '   (does not exist yet — run: make init)'
  printf '\n'

  head_ "Global config files"
  local entry fname desc path status
  for entry in "${GLOBAL_FILES[@]}"; do
    fname="${entry%%|*}"; desc="${entry#*|}"
    path="${CONFIG_DIR}/${fname}"
    if [[ -f "${path}" ]]; then status="present"; else status="missing"; fi
    printf '  [%-7s] %-28s %s\n' "${status}" "${fname}" "${desc}"
  done

  head_ "Egress CA (signs intercepted TLS; inspect with 'cid ca')"
  if [[ -f "${CONFIG_DIR}/ca/ca.crt" ]]; then status="present"; else status="missing"; fi
  printf '  [%-7s] %-28s %s\n' "${status}" "ca/ca.crt + ca.key" \
    "Created by 'make ca'; the key never enters a Claude container"

  head_ "Build-time config (stays in the repo)"
  local ipath="${SCRIPT_DIR}/install_additional_packages.sh"
  if [[ -f "${ipath}" ]]; then status="present"; else status="missing"; fi
  printf '  [%-7s] %-28s %s\n' "${status}" "install_additional_packages.sh" \
    "Baked into the base image; lives at ${ipath}"
  local capath="${SCRIPT_DIR}/egress-ca.crt"
  if [[ -f "${capath}" ]]; then status="present"; else status="missing"; fi
  printf '  [%-7s] %-28s %s\n' "${status}" "egress-ca.crt" \
    "Public CA copy run.sh syncs into the image trust store"

  head_ "Per-project config"
  printf '  projects dir: %s\n' "${PROJECTS_DIR}"
  if [[ -d "${PROJECTS_DIR}" ]]; then
    local n; n="$(find "${PROJECTS_DIR}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
    printf '  %s project dir(s). Inspect one with: cid project [dir]\n' "${n}"
  else
    printf '  (none yet — created on first run in a project)\n'
  fi
  printf '\n'
}

cmd_show() {
  local fname="${1:-}"
  [[ -n "${fname}" ]] || { err "usage: cid show <file>"; return 2; }
  # Basename only — no path components, so 'show' can never read outside the
  # config dir (or the repo, for the one build-time file).
  if [[ "${fname}" == */* || "${fname}" == "." || "${fname}" == ".." ]]; then
    err "refusing: give a bare filename, e.g. 'cid show settings.json'"
    return 2
  fi
  if [[ "${fname}" == ".credentials.json" ]]; then
    local cpath="${CONFIG_DIR}/.credentials.json"
    if [[ -f "${cpath}" ]]; then
      err "Refusing to print credentials. ${cpath} exists (mode $(stat -c '%a' "${cpath}" 2>/dev/null || stat -f '%A' "${cpath}" 2>/dev/null))."
    else
      err "${cpath} does not exist. Run: make init"
    fi
    return 1
  fi
  local path
  if [[ "${fname}" == "install_additional_packages.sh" ]]; then
    path="${SCRIPT_DIR}/${fname}"   # build-time file, stays in the repo
  else
    path="${CONFIG_DIR}/${fname}"
  fi
  if [[ ! -f "${path}" ]]; then
    err "not found: ${path}"
    err "known files: $(printf '%s ' "${GLOBAL_FILES[@]%%|*}")install_additional_packages.sh"
    return 1
  fi
  printf '# %s\n' "${path}"
  cat "${path}"
}

cmd_project() {
  local dir; dir="$(cd "${1:-$PWD}" 2>/dev/null && pwd)" || { err "no such dir: ${1:-$PWD}"; return 1; }
  local key pdir
  key="$(project_key "${dir}")"
  pdir="${PROJECTS_DIR}/${key}"
  head_ "Project"
  printf '  path:  %s\n' "${dir}"
  printf '  key:   %s   (Squid proxy username / volume suffix)\n' "${key}"
  printf '  dir:   %s' "${pdir}"
  [[ -d "${pdir}" ]] || printf '   (not created yet — created on first run here)'
  printf '\n'

  head_ "Overrides (fall back to the global file when absent)"
  local f
  for f in allowed-domains.txt splice-domains.txt docker-containers.txt .env container-CLAUDE.md mcp-servers.json claude.json install_additional_packages.sh; do
    if [[ -f "${pdir}/${f}" ]]; then
      printf '  [override] %s\n' "${f}"
    else
      printf '  [global  ] %s\n' "${f}"
    fi
  done
  printf '\n'
}

# ---- allowlist editing -----------------------------------------------------
#
# Two allowlists share this machinery, both "one bare entry per line, '#'
# comments": allowed-domains.txt (egress hosts, enforced by Squid) and
# docker-containers.txt (containers the docker bridge may inspect). The kind is
# resolved once by _resolve_target, which sets the TARGET_* globals the generic
# add/rm use.

# The bare entry on an allowlist line: everything before '#', whitespace-stripped.
# Mirrors proxy/ext-allowlist.sh so "present" here means the same as "allowed".
_entry_of() { local l="${1%%#*}"; printf '%s' "${l}" | tr -d '[:space:]'; }

# Reject anything that isn't a plausible hostname / wildcard entry, so we never
# append a line the proxy would ignore or that smuggles in a comment/whitespace.
# Accepts a leading '.' (wildcard: apex + subdomains), letters, digits, '-', '.'.
_valid_host() {  # <host>
  local h="$1"
  [[ -n "${h}" ]] || return 1
  [[ "${h}" =~ ^\.?([a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?\.)*[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?$ ]]
}

# Docker's own container-name charset, plus an optional trailing '*' the bridge
# reads as a prefix glob. Mirrors NAME_RE in docker-bridge/host-docker-bridge.js.
_valid_container() {  # <name>
  local n="$1"
  [[ -n "${n}" ]] || return 1
  [[ "${n}" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}\*?$ ]]
}

# A permission rule as it appears in permissions.allow ("Bash(python3 *)"). Any
# character is legal inside one, so this only rejects what the FILE format
# cannot carry: nothing, a leading '#', or an embedded newline/tab.
_valid_rule() {  # <rule>
  local r="$1"
  [[ -n "${r}" ]] || return 1
  case "${r}" in '#'*|*$'\n'*|*$'\t'*) return 1 ;; esac
  return 0
}

# The bare entry on a trusted-settings-rules.txt line. A permission rule contains
# spaces, quotes and globs, so unlike _entry_of nothing internal is stripped:
# only a line whose first non-blank character is '#' counts as a comment.
_rule_of() {  # <line>
  local l="$1"
  l="${l#"${l%%[![:space:]]*}"}"
  l="${l%"${l##*[![:space:]]}"}"
  case "${l}" in '#'*) printf '' ;; *) printf '%s' "${l}" ;; esac
}

# Is <entry> already a line in <file>? Uses the kind's line parser, which
# _resolve_target set (dynamically scoped from _entries_add / _entries_rm).
_entry_in_file() {  # <entry> <file>
  local entry="$1" file="$2" line parser="${TARGET_PARSER:-_entry_of}"
  [[ -f "${file}" ]] || return 1
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "$("${parser}" "${line}")" == "${entry}" ]] && return 0
  done < "${file}"
  return 1
}

# The first raw line in <file> whose bare entry equals <entry>, verbatim
# (comment/expiry annotation intact) — or nothing.
_raw_line_for() {  # <entry> <file>
  local entry="$1" file="$2" line
  [[ -f "${file}" ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "$(_entry_of "${line}")" == "${entry}" ]]; then printf '%s' "${line}"; return 0; fi
  done < "${file}"
}

# Rewrite <file> dropping any line whose bare entry equals <entry>. No-op if absent.
_drop_entry() {  # <entry> <file>
  local entry="$1" file="$2"
  [[ -f "${file}" ]] || return 0
  local tmp line
  tmp="$(mktemp "${file}.XXXXXX")"
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "$(_entry_of "${line}")" == "${entry}" ]] && continue
    printf '%s\n' "${line}"
  done < "${file}" > "${tmp}"
  mv "${tmp}" "${file}"
}

# Resolve the target allowlist for add/rm. Sets TARGET_FILE, TARGET_LABEL and the
# per-kind TARGET_VALIDATOR / TARGET_PARSER / TARGET_HINT / TARGET_APPLIES /
# TARGET_LOWER. The baseline allowed-domains.txt must already exist (the proxy
# mounts exactly that path, so a typo'd new file would silently do nothing);
# every other file is created on demand.
_resolve_target() {  # <global?0|1> <dir> <kind: domains|containers|rules>
  local is_global="$1" dir="$2" kind="$3" name
  TARGET_PARSER='_entry_of'
  case "${kind}" in
    domains)
      name='allowed-domains.txt'
      TARGET_VALIDATOR='_valid_host'
      TARGET_HINT="not a valid hostname (letters, digits, '.', '-'; leading '.' = wildcard)"
      TARGET_APPLIES='applies within ~2s, no restart'
      TARGET_LOWER=1
      ;;
    splice)
      # Hosts the proxy must NOT decrypt. Same grammar and cache as domains, a
      # different question — see docs/tls-inspection.md.
      name='splice-domains.txt'
      TARGET_VALIDATOR='_valid_host'
      TARGET_HINT="not a valid hostname (letters, digits, '.', '-'; leading '.' = wildcard)"
      TARGET_APPLIES='applies within ~2s, no restart'
      TARGET_LOWER=1
      ;;
    containers)
      name='docker-containers.txt'
      TARGET_VALIDATOR='_valid_container'
      TARGET_HINT="not a valid container name (letters, digits, '_', '.', '-'; trailing '*' = prefix glob)"
      TARGET_APPLIES='applies to the next bridge call — no session restart'
      TARGET_LOWER=0
      ;;
    rules)
      # permissions.allow rules the settings scanner should stop flagging.
      name='trusted-settings-rules.txt'
      TARGET_VALIDATOR='_valid_rule'
      TARGET_PARSER='_rule_of'
      TARGET_HINT="not a usable rule (empty, or contains a leading '#', a tab or a newline)"
      TARGET_APPLIES='applies to the next run in that project'
      TARGET_LOWER=0
      ;;
    *) err "internal: unknown allowlist kind '${kind}'"; return 1 ;;
  esac

  if [[ "${is_global}" == 1 ]]; then
    TARGET_FILE="${CONFIG_DIR}/${name}"
    TARGET_LABEL="baseline"
    if [[ ( "${kind}" == domains || "${kind}" == splice ) && ! -f "${TARGET_FILE}" ]]; then
      err "baseline list not found: ${TARGET_FILE}"
      err "run 'make init' first (the proxy mounts exactly this file)."
      return 1
    fi
    return 0
  fi
  local rdir; rdir="$(cd "${dir}" 2>/dev/null && pwd)" || { err "no such dir: ${dir}"; return 1; }
  local key; key="$(project_key "${rdir}")"
  TARGET_FILE="${PROJECTS_DIR}/${key}/${name}"
  TARGET_LABEL="project ${key}"
}

_entries_add() {  # <kind> <global> <dir> <entry>...
  local kind="$1" is_global="$2" dir="$3"; shift 3
  local TARGET_FILE TARGET_LABEL TARGET_VALIDATOR TARGET_PARSER TARGET_HINT TARGET_APPLIES TARGET_LOWER
  _resolve_target "${is_global}" "${dir}" "${kind}" || return 1

  local entry added=0
  for entry in "$@"; do
    [[ "${TARGET_LOWER}" == 1 ]] && entry="$(printf '%s' "${entry}" | tr '[:upper:]' '[:lower:]')"
    if ! "${TARGET_VALIDATOR}" "${entry}"; then
      err "  skip '${entry}' — ${TARGET_HINT}"
      continue
    fi
    if _entry_in_file "${entry}" "${TARGET_FILE}"; then
      # A domains entry with a "--for" expiry is promoted to permanent by a
      # plain (non-expiring) add, rather than treated as a no-op duplicate.
      if [[ "${kind}" == domains && "$(_raw_line_for "${entry}" "${TARGET_FILE}")" == *'# expires='* ]]; then
        _drop_entry "${entry}" "${TARGET_FILE}"
        printf '%s\n' "${entry}" >> "${TARGET_FILE}"
        note "promoted to permanent in ${TARGET_LABEL}: ${entry}"
        added=$((added + 1))
        continue
      fi
      note "already in ${TARGET_LABEL}: ${entry}"
      continue
    fi
    mkdir -p "$(dirname "${TARGET_FILE}")"
    printf '%s\n' "${entry}" >> "${TARGET_FILE}"
    note "added to ${TARGET_LABEL}: ${entry}"
    added=$((added + 1))
  done
  [[ "${added}" -gt 0 ]] && note "→ ${TARGET_FILE} (${TARGET_APPLIES})"
  return 0
}

_entries_rm() {  # <kind> <global> <dir> <entry>...
  local kind="$1" is_global="$2" dir="$3"; shift 3
  local TARGET_FILE TARGET_LABEL TARGET_VALIDATOR TARGET_PARSER TARGET_HINT TARGET_APPLIES TARGET_LOWER
  _resolve_target "${is_global}" "${dir}" "${kind}" || return 1

  if [[ ! -f "${TARGET_FILE}" ]]; then
    note "no ${TARGET_LABEL} allowlist yet (${TARGET_FILE}); nothing to remove"
    return 0
  fi

  local entry removed=0
  for entry in "$@"; do
    [[ "${TARGET_LOWER}" == 1 ]] && entry="$(printf '%s' "${entry}" | tr '[:upper:]' '[:lower:]')"
    if ! _entry_in_file "${entry}" "${TARGET_FILE}"; then
      note "not in ${TARGET_LABEL}: ${entry}"
      continue
    fi
    # Rewrite without the matching entry, preserving every other line verbatim
    # (comments, blanks, formatting). Only lines whose bare entry equals it are
    # dropped.
    local tmp line
    tmp="$(mktemp "${TARGET_FILE}.XXXXXX")"
    while IFS= read -r line || [[ -n "${line}" ]]; do
      [[ "$(_entry_of "${line}")" == "${entry}" ]] && continue
      printf '%s\n' "${line}"
    done < "${TARGET_FILE}" > "${tmp}"
    mv "${tmp}" "${TARGET_FILE}"
    note "removed from ${TARGET_LABEL}: ${entry}"
    removed=$((removed + 1))
  done
  [[ "${removed}" -gt 0 ]] && note "→ ${TARGET_FILE} (${TARGET_APPLIES})"
  return 0
}

# Seconds for a duration like "30s"/"15m"/"2h"/"1d" (bare digits = seconds).
_parse_duration() {  # <duration>
  local d="$1"
  [[ "${d}" =~ ^([0-9]+)([smhd]?)$ ]] || return 1
  local n="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}"
  n=$((10#${n}))   # force base-10: a leading zero (e.g. "018") would otherwise read as octal
  case "${unit}" in
    s|"") printf '%s' "${n}" ;;
    m)    printf '%s' "$((n * 60))" ;;
    h)    printf '%s' "$((n * 3600))" ;;
    d)    printf '%s' "$((n * 86400))" ;;
  esac
}

# Human-readable local time for an epoch: GNU date, then BSD/macOS date, then
# the bare epoch (matches the stat -c/-f fallback pattern used elsewhere here).
_fmt_epoch() {  # <epoch>
  date -d "@${1}" '+%Y-%m-%d %H:%M' 2>/dev/null \
    || date -r "${1}" '+%Y-%m-%d %H:%M' 2>/dev/null \
    || printf 'epoch %s' "${1}"
}

# `cid domains add --for <dur> <host>...`: (re)write each host with a fresh
# expiry, replacing any prior line (temporary or permanent) for that host. The
# proxy (proxy/ext-allowlist.sh) is what actually enforces the expiry; this
# only writes it.
_domains_add_temp() {  # <global> <dir> <for_dur> <host>...
  local is_global="$1" dir="$2" for_dur="$3"; shift 3
  local secs
  secs="$(_parse_duration "${for_dur}")" || {
    err "bad --for duration '${for_dur}' (want e.g. 30s, 15m, 2h, 1d)"; return 2
  }
  local expiry=$(( $(date +%s) + secs ))

  local TARGET_FILE TARGET_LABEL TARGET_VALIDATOR TARGET_PARSER TARGET_HINT TARGET_APPLIES TARGET_LOWER
  _resolve_target "${is_global}" "${dir}" domains || return 1

  local entry added=0
  for entry in "$@"; do
    entry="$(printf '%s' "${entry}" | tr '[:upper:]' '[:lower:]')"
    if ! _valid_host "${entry}"; then
      err "  skip '${entry}' — ${TARGET_HINT}"
      continue
    fi
    _drop_entry "${entry}" "${TARGET_FILE}"
    mkdir -p "$(dirname "${TARGET_FILE}")"
    printf '%s  # expires=%s\n' "${entry}" "${expiry}" >> "${TARGET_FILE}"
    note "added to ${TARGET_LABEL} until $(_fmt_epoch "${expiry}") (${for_dur}): ${entry}"
    added=$((added + 1))
  done
  [[ "${added}" -gt 0 ]] && note "→ ${TARGET_FILE} (${TARGET_APPLIES}; auto-expires — hygiene-prune with: cid domains prune)"
  return 0
}

cmd_domains_add() {  # <global> <dir> <for_dur> <host>...
  local is_global="$1" dir="$2" for_dur="$3"; shift 3
  [[ $# -ge 1 ]] || { err "usage: cid domains add [-g] [-C dir] [--for <dur>] <host>..."; return 2; }
  if [[ -z "${for_dur}" ]]; then
    _entries_add domains "${is_global}" "${dir}" "$@"
  else
    _domains_add_temp "${is_global}" "${dir}" "${for_dur}" "$@"
  fi
}

cmd_domains_rm() {  # <global> <dir> <host>...
  [[ $# -ge 3 ]] || { err "usage: cid domains rm [-g] [-C dir] <host>..."; return 2; }
  _entries_rm domains "$@"
}

cmd_domains_prune() {  # <global> <dir>
  local is_global="$1" dir="$2"
  local TARGET_FILE TARGET_LABEL TARGET_VALIDATOR TARGET_PARSER TARGET_HINT TARGET_APPLIES TARGET_LOWER
  _resolve_target "${is_global}" "${dir}" domains || return 1
  if [[ ! -f "${TARGET_FILE}" ]]; then
    note "no ${TARGET_LABEL} allowlist yet (${TARGET_FILE}); nothing to prune"
    return 0
  fi

  local now; now="$(date +%s)"
  local tmp line expiry pruned=0
  tmp="$(mktemp "${TARGET_FILE}.XXXXXX")"
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" == *'# expires='* ]]; then
      expiry="${line##*expires=}"
      expiry="${expiry%%[![:digit:]]*}"
      if [[ -n "${expiry}" && "${expiry}" -le "${now}" ]]; then
        pruned=$((pruned + 1))
        continue
      fi
    fi
    printf '%s\n' "${line}"
  done < "${TARGET_FILE}" > "${tmp}"
  mv "${tmp}" "${TARGET_FILE}"
  if [[ "${pruned}" -gt 0 ]]; then
    note "pruned ${pruned} expired entrie(s) from ${TARGET_LABEL}"
  else
    note "nothing to prune in ${TARGET_LABEL}"
  fi
}

cmd_splice_add() {  # <global> <dir> <host>...
  [[ $# -ge 3 ]] || { err "usage: cid splice add [-g] [-C dir] <host>..."; return 2; }
  _entries_add splice "$@"
}

cmd_splice_rm() {  # <global> <dir> <host>...
  [[ $# -ge 3 ]] || { err "usage: cid splice rm [-g] [-C dir] <host>..."; return 2; }
  _entries_rm splice "$@"
}

cmd_containers_add() {  # <global> <dir> <name>...
  [[ $# -ge 3 ]] || { err "usage: cid containers add [-g] [-C dir] <name>..."; return 2; }
  _entries_add containers "$@"
}

cmd_containers_rm() {  # <global> <dir> <name>...
  [[ $# -ge 3 ]] || { err "usage: cid containers rm [-g] [-C dir] <name>..."; return 2; }
  _entries_rm containers "$@"
}

# Print a file with a header, or a "using template" / "none" note.
_dump_list() {  # <label> <path> [fallback-path]
  local label="$1" path="$2" fallback="${3:-}"
  if [[ -f "${path}" ]]; then
    printf '# %s: %s\n' "${label}" "${path}"
    cat "${path}"
  elif [[ -n "${fallback}" && -f "${fallback}" ]]; then
    printf '# %s: %s (config copy absent — this template is what the proxy uses)\n' "${label}" "${fallback}"
    cat "${fallback}"
  else
    printf '# %s: none\n' "${label}"
  fi
  printf '\n'
}

cmd_domains_show() {  # [dir]
  local dir; dir="$(cd "${1:-$PWD}" 2>/dev/null && pwd)" || { err "no such dir: ${1:-$PWD}"; return 1; }
  local key pdir
  key="$(project_key "${dir}")"
  pdir="${PROJECTS_DIR}/${key}"
  head_ "Effective egress allowlist for ${key}"
  printf 'The proxy allows a host if it matches EITHER list below.\n'
  _dump_list "Baseline" "${CONFIG_DIR}/allowed-domains.txt" "${TEMPLATES_DIR}/allowed-domains.txt"
  _dump_list "Per-project additions" "${pdir}/allowed-domains.txt"
}

cmd_splice_show() {  # [dir]
