  printf 'has to be in the egress allowlist to be reachable). See docs/tls-inspection.md.\n'
  _dump_list "Baseline" "${CONFIG_DIR}/splice-domains.txt" "${TEMPLATES_DIR}/splice-domains.txt"
  _dump_list "Per-project additions" "${pdir}/splice-domains.txt"
}

cmd_containers_show() {  # [dir]
  local dir; dir="$(cd "${1:-$PWD}" 2>/dev/null && pwd)" || { err "no such dir: ${1:-$PWD}"; return 1; }
