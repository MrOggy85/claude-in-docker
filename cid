# ---- project Claude settings -----------------------------------------------
#
# The read-only side of guards/project-settings.sh: same scanner, same trusted
# rules, so what is shown here is exactly what the guard will (or will not)
# prompt about. See docs/attack-vectors.md.

_settings_files() {  # <project dir> — prints one path per line, may print none
  local dir="$1" f
  for f in settings.json settings.local.json; do
    [[ -f "${dir}/.claude/${f}" ]] && printf '%s\n' "${dir}/.claude/${f}"
  done
  return 0
}

cmd_settings_show() {  # [dir]
  local dir; dir="$(cd "${1:-$PWD}" 2>/dev/null && pwd)" || { err "no such dir: ${1:-$PWD}"; return 1; }
  local key pdir
  key="$(project_key "${dir}")"
  pdir="${PROJECTS_DIR}/${key}"

  head_ "Project Claude settings for ${key}"
  local -a files=()
  while IFS= read -r f; do [[ -n "${f}" ]] && files+=("${f}"); done < <(_settings_files "${dir}")
  if (( ${#files[@]} == 0 )); then
    printf '  none — no .claude/settings.json or .claude/settings.local.json in %s\n' "${dir}"
    printf '  Nothing for the guard to ask about.\n\n'
    return 0
  fi
  local f
  for f in "${files[@]}"; do printf '  file: %s\n' "${f}"; done

  local scan flagged accepted
  scan="$("${SCRIPT_DIR}/scripts/scan-project-settings.sh" -p "${dir}" "${files[@]}")"
  flagged="$(printf '%s\n' "${scan}" | grep -v $'^OK\t' || true)"
  accepted="$(printf '%s\n' "${scan}" | awk -F'\t' '$1=="OK" {n+=$2} END {print n+0}')"

  printf '\n'
  if [[ -z "${flagged}" ]]; then
    printf '  Nothing flagged. %s allow rule(s) grant no capability worth a prompt.\n' "${accepted}"
  else
    # Same renderer the guard uses, so this shows exactly what a prompt would.
    "${SCRIPT_DIR}/scripts/scan-project-settings.sh" --render <<< "${flagged}"
    printf '\n  %s further allow rule(s) grant nothing and are not listed.\n' "${accepted}"
  fi

  head_ "Approval"
  local memo="${pdir}/approved-project-settings"
  if [[ -z "${flagged}" ]]; then
    printf '  Not needed — the guard does not prompt when nothing is flagged.\n'
  elif [[ ! -f "${memo}" ]]; then
    printf '  Not approved yet — the next run in this project will prompt once.\n'
  else
    # Must match _ps_sha in guards/project-settings.sh byte for byte (no
    # trailing newline), or every profile would read as stale here.
    local digest prev
    digest="$(printf '%s' "${flagged}" | sha256_ - | cut -d' ' -f1)"
    prev="$(sed -n '1p' "${memo}")"
    if [[ "${digest}" == "${prev}" ]]; then
      printf '  Approved and current — no prompt on the next run.\n'
    else
      printf '  Approved profile is STALE — the next run will prompt and mark what changed.\n'
    fi
    printf '  memo: %s   (clear it with: cid settings forget)\n' "${memo}"
  fi

  head_ "Trusted rules (never flagged)"
  _dump_list "Baseline" "${CONFIG_DIR}/trusted-settings-rules.txt"
  _dump_list "Per-project additions" "${pdir}/trusted-settings-rules.txt"
}

cmd_settings_forget() {  # <global-ignored> <dir>
  local dir; dir="$(cd "${2:-$PWD}" 2>/dev/null && pwd)" || { err "no such dir: ${2:-$PWD}"; return 1; }
  local memo; memo="${PROJECTS_DIR}/$(project_key "${dir}")/approved-project-settings"
  if [[ -f "${memo}" ]]; then
    rm -f "${memo}"
    note "forgot the approved risk profile: ${memo}"
    note "the next run in ${dir} will prompt again"
  else
    note "nothing to forget (${memo} does not exist)"
  fi
}

cmd_settings_trust() {  # <global> <dir> <rule>...
  [[ $# -ge 3 ]] || { err "usage: cid settings trust [-g] [-C dir] '<rule>'..."; return 2; }
  _entries_add rules "$@"
}

cmd_settings_untrust() {  # <global> <dir> <rule>...
  [[ $# -ge 3 ]] || { err "usage: cid settings untrust [-g] [-C dir] '<rule>'..."; return 2; }
  _entries_rm rules "$@"
}

# Dispatcher for `cid settings`, shaped like _cmd_allowlist but with its own
# verbs. Rules start with a letter, so they never collide with the verb names.
cmd_settings() {
  local sub="" is_global=0 dir="${PWD}"
  local -a items=()
  local a
  while [[ $# -gt 0 ]]; do
    a="$1"; shift
    case "${a}" in
      -g|--global)        is_global=1 ;;
      -C|--dir|--project) dir="${1:?-C needs a directory}"; shift ;;
      trust)           if [[ -z "${sub}" ]]; then sub='trust';   else items+=("${a}"); fi ;;
      untrust)         if [[ -z "${sub}" ]]; then sub='untrust'; else items+=("${a}"); fi ;;
      forget)          if [[ -z "${sub}" ]]; then sub='forget';  else items+=("${a}"); fi ;;
      ls|show|list)    if [[ -z "${sub}" ]]; then sub='show';    else items+=("${a}"); fi ;;
      -h|--help)       cmd_help; return 0 ;;
      -*)              err "unknown flag: ${a}"; return 2 ;;
      *)               items+=("${a}") ;;
    esac
  done

  case "${sub}" in
    trust)   cmd_settings_trust   "${is_global}" "${dir}" "${items[@]+"${items[@]}"}" ;;
    untrust) cmd_settings_untrust "${is_global}" "${dir}" "${items[@]+"${items[@]}"}" ;;
    forget)  cmd_settings_forget  "${is_global}" "${dir}" ;;
    show|"") cmd_settings_show "${items[0]:-${dir}}" ;;
  esac
}

# Shared dispatcher for `cid domains` / `cid containers`: parse the optional
# sub-verb (add/rm/ls) and its -g / -C flags, then hand off. With no sub-verb it
# shows the effective list.
_cmd_allowlist() {  # <kind: domains|containers> [args...]
  local kind="$1"; shift
  local sub="" is_global=0 dir="${PWD}" for_dur=""
  local -a items=()
  local a
  while [[ $# -gt 0 ]]; do
    a="$1"; shift
    case "${a}" in
      -g|--global)        is_global=1 ;;
      -C|--dir|--project) dir="${1:?-C needs a directory}"; shift ;;
      --for)              for_dur="${1:?--for needs a duration}"; shift ;;
      add)             if [[ -z "${sub}" ]]; then sub='add';   else items+=("${a}"); fi ;;
      rm|remove)       if [[ -z "${sub}" ]]; then sub='rm';    else items+=("${a}"); fi ;;
      prune)           if [[ -z "${sub}" ]]; then sub='prune'; else items+=("${a}"); fi ;;
      ls|show|list)    if [[ -z "${sub}" ]]; then sub='show';  else items+=("${a}"); fi ;;
      -h|--help)       cmd_help; return 0 ;;
      -*)              err "unknown flag: ${a}"; return 2 ;;
      *)               items+=("${a}") ;;
    esac
  done

  if [[ -n "${for_dur}" && ( "${kind}" != domains || "${sub}" != add ) ]]; then
    err "--for is only valid for 'cid domains add'"; return 2
  fi
  if [[ "${sub}" == prune && "${kind}" != domains ]]; then
    err "'prune' is only valid for 'cid domains'"; return 2
  fi

  case "${sub}" in
    add)
      if [[ "${kind}" == domains ]]; then
        cmd_domains_add "${is_global}" "${dir}" "${for_dur}" "${items[@]+"${items[@]}"}"
      else
        "cmd_${kind}_add" "${is_global}" "${dir}" "${items[@]+"${items[@]}"}"
      fi
      ;;
    rm)   "cmd_${kind}_rm"  "${is_global}" "${dir}" "${items[@]+"${items[@]}"}" ;;
    prune) cmd_domains_prune "${is_global}" "${dir}" ;;
    show|"") "cmd_${kind}_show" "${items[0]:-${dir}}" ;;
  esac
}

# ---- egress CA -------------------------------------------------------------

# Read-only view of the CA the proxy signs intercepted TLS with. Answers the two
# questions a certificate error raises: is there a valid CA, and is the copy the
# image trusts the same one the proxy signs with. Prints the certificate only —
# never ca.key. See docs/tls-inspection.md.
cmd_ca() {
  local dir="${CONFIG_DIR}/ca" crt="${CONFIG_DIR}/ca/ca.crt" key="${CONFIG_DIR}/ca/ca.key"
  local ctx="${SCRIPT_DIR}/egress-ca.crt"

  head_ "Egress CA"
  printf '  dir: %s\n' "${dir}"
  if [[ ! -f "${crt}" || ! -f "${key}" ]]; then
    printf '  MISSING — TLS interception cannot work. Create it with: make ca\n\n'
    return 1
  fi
  printf '  key: %s   (mode %s; mounted only into the proxy container)\n' \
    "${key}" "$(stat -c '%a' "${key}" 2>/dev/null || stat -f '%A' "${key}" 2>/dev/null)"
  printf '  crt: %s\n' "${crt}"

  if command -v openssl >/dev/null 2>&1; then
    printf '  subject:     %s\n' "$(openssl x509 -in "${crt}" -noout -subject 2>/dev/null | sed 's/^subject=//')"
    printf '  expires:     %s\n' "$(openssl x509 -in "${crt}" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')"
    printf '  fingerprint: %s\n' "$(openssl x509 -in "${crt}" -noout -fingerprint -sha256 2>/dev/null | sed 's/^.*=//')"
    if ! openssl x509 -in "${crt}" -noout -checkend 0 >/dev/null 2>&1; then
      printf '  EXPIRED — every TLS request in the container will fail.\n'
      printf '  Rotate: rm -rf %s && make ca && make proxy-up\n' "${dir}"
    fi
  else
    printf '  (install openssl to see subject/expiry/fingerprint)\n'
  fi

  head_ "Copy baked into the image (build context)"
  printf '  %s\n' "${ctx}"
  if [[ ! -f "${ctx}" ]]; then
    printf '  not synced yet — the next run.sh writes it and rebuilds the image\n\n'
  elif cmp -s "${crt}" "${ctx}"; then
    printf '  in sync with the CA above\n\n'
  else
    printf '  STALE — the next run.sh re-syncs it and rebuilds the image\n\n'
  fi
}

# ---- environment variables -------------------------------------------------

# The host env vars a user may set before `run.sh`. A terse mirror of
# docs/environment-variables.md (the fuller reference) — keep the two in sync
# when adding a variable. Each entry: "group|NAME|default|description".
# (Secret values are masked in the output; see SECRET_VARS below.)
ENV_VARS=(
  "Configuration|CLAUDE_DOCKER_CONFIG_DIR|~/.config/claude-in-docker|Directory holding all user config (settings, credentials, allowlists)"
  "Configuration|CLAUDE_PROJECTS_DIR|<config-dir>/projects|Base directory for the per-project config dirs"
  "Configuration|CLAUDE_MOUNTS|(unset)|Extra host folders to bind-mount into the container"
  "Configuration|CLAUDE_PORTS|(unset)|Ports to publish from the container to the host"
  "Configuration|CLAUDE_VOLUME_PATHS|(unset)|Extra in-container paths to back with named volumes"
  "Configuration|SKIP_CLAUDE_VOLUME_PATHS|(unset)|Disable all volume-backing, including node_modules"
  "Configuration|MCP_GH_BEARER|(unset)|Read-only GitHub token for the GitHub MCP server"
  "Configuration|CLAUDE_ALLOW_PROJECT_SETTINGS|(unset)|Auto-accept a project-level .claude/settings.json"
  "Configuration|CLAUDE_PROJECT_SETTINGS_STRICT|(unset)|Set 1 to review the whole settings file every run, ignoring approvals"
  "Configuration|SOUND_PORT|4767|Host port the container reaches to play sound effects"
  "Configuration|CLAUDE_HOST_OUTBOUND_PORTS|(unset)|Extra host ports the container may connect out to"
  "Configuration|CHROME_DEVTOOLS_MCP_PORT|9333|Host port for the chrome-devtools-mcp bridge (host-only)"
  "Configuration|CHROME_DEVTOOLS_MCP_EXTRA_ARGS|(unset)|Extra flags passed to chrome-devtools-mcp (host-only)"
  "Configuration|CLAUDE_DOCKER_BRIDGE|(unset)|Set 1 to enable read-only host docker access (off by default)"
  "Configuration|DOCKER_BRIDGE_PORT|9334|Host port for the read-only docker bridge"
  "Configuration|DOCKER_BRIDGE_BIND|0.0.0.0|Address the docker bridge listens on (host-only)"
  "Configuration|DOCKER_BRIDGE_DOCKER_CMD|docker|Path to the docker CLI the bridge runs (host-only)"
  "Configuration|CLAUDE_SANDBOX_INFO|1|Set 0 to skip the sandbox skill (session can't look up its ports/mounts)"
  "Configuration|CLAUDE_VOLUME|claude-<project>-<hash>|Override the per-project session volume name"
  "Configuration|CLAUDE_CONTAINER_NAME|claude-<project>-<random>|Pin the container name instead of the random default"
  "Egress proxy|CLAUDE_EGRESS_NETWORK|claude-egress|Docker network shared by the proxy and containers"
  "Egress proxy|CLAUDE_EGRESS_PROXY_NAME|claude-egress-proxy|Name of the long-running Squid container"
  "Egress proxy|CLAUDE_EGRESS_IMAGE|claude-egress-squid:local|Squid image proxy/up.sh runs (set to skip building proxy/Dockerfile)"
  "Usage tracking|CLAUDE_AUTO_USAGE|1|Set 0 to skip the automatic usage sync after each run"
  "Usage tracking|CLAUDE_USAGE_DIR|~/.claude-docker-usage|Where the cost-only usage logs are kept"
  "Usage tracking|CLAUDE_USAGE_ONLINE|(unset)|Fetch live LiteLLM pricing instead of offline"
  "Usage tracking|CCUSAGE_VERSION|latest|npm version used for the npx ccusage fallback"
  "Output|NO_COLOR|(unset)|Set to any value to disable colour in every message (wins over the rest)"
  "Output|CLICOLOR_FORCE|(unset)|Set to colour even through a pipe or under TERM=dumb"
)

# Names whose value must never be printed (tokens/secrets); shown as <set: hidden>.
SECRET_VARS=" MCP_GH_BEARER "

cmd_env() {
  local filter="${1:-}"
  head_ "Environment variables you can set"
  printf 'Set inline for one run (e.g. CLAUDE_MOUNTS=… run.sh) or export from your\n'
  printf 'shell profile / claude alias. A leading * marks ones set right now.\n'
  printf 'Fuller reference: docs/environment-variables.md\n'

  local last_group="" entry group name def desc mark val shown=0
  for entry in "${ENV_VARS[@]}"; do
    IFS='|' read -r group name def desc <<< "${entry}"
    [[ -n "${filter}" && "${name}" != *"${filter}"* ]] && continue
    shown=$((shown + 1))
    if [[ "${group}" != "${last_group}" ]]; then
      printf '\n%s\n' "${group}"; last_group="${group}"
    fi
    # Show the resolved paths for the two config-location vars.
    case "${name}" in
      CLAUDE_DOCKER_CONFIG_DIR) def="${CONFIG_DIR}" ;;
      CLAUDE_PROJECTS_DIR)      def="${PROJECTS_DIR}" ;;
    esac
    if _is_set "${name}"; then
      mark='*'
      if [[ "${SECRET_VARS}" == *" ${name} "* ]]; then val='<set: hidden>'; else val="${!name}"; fi
    else
      mark=' '
      val="${def}"
    fi
    printf ' %s %-31s %-26s %s\n' "${mark}" "${name}" "${val}" "${desc}"
  done

  if [[ "${shown}" -eq 0 ]]; then
    printf '\n(no variable name matches "%s")\n\n' "${filter}"
    return 1
  fi
  printf '\nPlus: any KEY=VALUE line in %s/.env is injected into the container.\n\n' "${CONFIG_DIR}"
}

cmd_help() {
  cat <<EOF
cid — inspect and edit the claude-in-docker configuration.

Config lives in: ${CONFIG_DIR}

Commands:
  list                    Config dir + every global file (present/missing) + projects dir
  show <file>             Print a global config file (credentials are never dumped)
  project [dir]           Per-project key, config dir, and which overrides exist
  domains [dir]           Effective egress allowlist (baseline + per-project) for a project
  domains add <host>...   Add host(s) to the per-project list (-g for the baseline)
  domains add --for <dur> <host>...
                          Same, but the entry expires after <dur> (15m, 2h, 1d, ...)
  domains rm  <host>...   Remove host(s) from the per-project list (-g for the baseline)
  domains prune           Drop expired --for entries (hygiene only; the proxy already
                          ignores them)
  splice [dir]            Hosts the proxy tunnels without decrypting TLS
  splice add <host>...    Stop decrypting a host (-g for the baseline)
  splice rm  <host>...    Decrypt it again (-g for the baseline)
  ca                      The egress CA: path, expiry, fingerprint, image copy status
  containers [dir]        Containers the docker bridge may inspect (baseline + per-project)
  containers add <name>...  Allow container(s) for this project (-g for the baseline)
  containers rm  <name>...  Disallow container(s) (-g for the baseline)
  settings [dir]          What the project's .claude/settings*.json grants, and whether
                          the guard will prompt about it
  settings trust '<rule>'...   Stop flagging a permissions.allow rule (-g: everywhere)
  settings untrust '<rule>'... Flag it again
  settings forget         Drop the approved risk profile, so the next run re-prompts
  env [filter]            List the env vars you can set (current value / default)
  help                    This help

domains|splice|containers|settings sub-verb flags:
  -g, --global            Target the shared baseline list (not the current project)
  -C, --dir <dir>         Select the project by directory (default: current dir)

Examples:
  cid domains add example.com              # allow example.com for THIS project
  cid domains add .githubusercontent.com   # wildcard: apex + all subdomains
  cid domains add -g registry.npmjs.org    # allow for EVERY project (baseline)
  cid domains add --for 15m github.com     # allow for 15 minutes, then auto-deny
  cid domains rm  example.com              # remove from this project's list
  cid domains prune                        # drop expired --for entries
  cid splice add api.example.com           # stop decrypting it (a pinning client)
  cid ca                                   # is the CA valid, and does the image have it
  cid containers add myapp-web             # let the bridge read this container
  cid containers add 'myapp-*'             # trailing '*' = prefix glob (quote it)
  cid settings                             # what this project's settings grant
  cid settings trust 'Bash(python3 *)'     # accept that rule here without a prompt
  cid settings trust -g 'Bash(npx *)'      # ...in every project

Domain edits apply within ~2s (Squid re-reads the lists live — no rebuild/restart);
container edits apply to the next bridge call.
Seed the config dir with 'make init'; migrate an old repo-root config with 'make migrate'.
EOF
}

main() {
  local cmd="${1:-list}"; shift || true
  case "${cmd}" in
    list|"")     cmd_list ;;
    show)        cmd_show "$@" ;;
    project)     cmd_project "$@" ;;
    domains)     _cmd_allowlist domains "$@" ;;
    splice)      _cmd_allowlist splice "$@" ;;
    containers)  _cmd_allowlist containers "$@" ;;
    ca)          cmd_ca ;;
    settings)    cmd_settings "$@" ;;
    env)         cmd_env "$@" ;;
    help|-h|--help) cmd_help ;;
    *) err "unknown command: ${cmd}"; err "run: cid help"; return 2 ;;
  esac
}

main "$@"
