#compdef cid
# zsh completion for the `cid` CLI.
#
# Install: see the "Shell completion" section in docs/config-cli.md. In short,
# put this file's directory on $fpath before compinit, e.g. in ~/.zshrc:
#
#   fpath=(/path/to/repo/completions $fpath)
#   autoload -Uz compinit && compinit
#
# Works for `cid`, `./cid`, and `/abs/path/cid` (zsh falls back to the basename).

# The config dir, resolved the same way scripts/paths.sh does.
_cid_config_dir() {
  print -r -- "${CLAUDE_DOCKER_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-in-docker}"
}

# Bare filenames `show` accepts (global config files + the one build-time file).
_cid_files() {
  local -a files
  files=(
    settings.json claude.json mcp-servers.json container-CLAUDE.md
    .gitconfig .gitignore_global .credentials.json allowed-domains.txt
    splice-domains.txt docker-containers.txt trusted-settings-rules.txt .env
    install_additional_packages.sh
  )
  _describe -t files 'config file' files
}

# Names of the settable env vars — the optional filter argument to `cid env`.
# Kept in step with the ENV_VARS list in the `cid` script.
_cid_envvars() {
  local -a vars
  vars=(
    CLAUDE_DOCKER_CONFIG_DIR CLAUDE_PROJECTS_DIR CLAUDE_MOUNTS CLAUDE_PORTS
    CLAUDE_VOLUME_PATHS SKIP_CLAUDE_VOLUME_PATHS MCP_GH_BEARER
    CLAUDE_ALLOW_PROJECT_SETTINGS CLAUDE_PROJECT_SETTINGS_STRICT
    SOUND_PORT CLAUDE_HOST_OUTBOUND_PORTS
    CHROME_DEVTOOLS_MCP_PORT CHROME_DEVTOOLS_MCP_EXTRA_ARGS
    CLAUDE_DOCKER_BRIDGE DOCKER_BRIDGE_PORT DOCKER_BRIDGE_BIND
    DOCKER_BRIDGE_DOCKER_CMD CLAUDE_VOLUME
    CLAUDE_CONTAINER_NAME CLAUDE_EGRESS_NETWORK CLAUDE_EGRESS_PROXY_NAME
    CLAUDE_EGRESS_IMAGE CLAUDE_AUTO_USAGE CLAUDE_USAGE_DIR CLAUDE_USAGE_ONLINE
    CCUSAGE_VERSION
  )
  _describe -t envvars 'environment variable' vars
}

# Entries already on any allowlist of the given basename (baseline + every
# project) — completion hints for `domains rm` / `containers rm`. Only a hint; rm
# still resolves the right file itself.
_cid_entries() {  # <basename> <tag> <description>
  local cfg; cfg=$(_cid_config_dir)
  local -a entries=() f
  for f in "$cfg/$1" "$cfg"/projects/*/"$1"(N); do
    [[ -f $f ]] || continue
    entries+=(${(f)"$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' -e 's/[[:space:]]//g' "$f" 2>/dev/null)"})
  done
  (( ${#entries} )) && _describe -t "$2" "$3" entries
}

_cid_hosts() {
  _cid_entries allowed-domains.txt hosts 'allowed host'
}

_cid_spliced() {
  _cid_entries splice-domains.txt hosts 'spliced host'
}

_cid_containers() {
  _cid_entries docker-containers.txt containers 'allowed container'
}

# Trusted permission rules — hints for `settings untrust`. Not _cid_entries:
# a rule contains spaces and '#' may appear inside it, so only whole-line
# comments are dropped and nothing internal is stripped.
_cid_rules() {
  local cfg; cfg=$(_cid_config_dir)
  local -a entries=() f
  for f in "$cfg/trusted-settings-rules.txt" "$cfg"/projects/*/trusted-settings-rules.txt(N); do
    [[ -f $f ]] || continue
    entries+=(${(f)"$(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$f" 2>/dev/null)"})
  done
  (( ${#entries} )) && _describe -t rules 'trusted rule' entries
}

_cid() {
  local curcontext="$curcontext" state line
  local -a cmds
  cmds=(
    'list:config dir + global files + projects dir'
    'show:print a global config file'
    'project:per-project key, config dir, and overrides'
    'domains:show or edit the egress allowlist'
    'splice:show or edit the hosts whose TLS is not decrypted'
    'ca:show the egress CA (path, expiry, fingerprint)'
    'containers:show or edit the docker-bridge container allowlist'
    'settings:what the project .claude/settings*.json grants'
    'env:list the environment variables you can set'
    'help:show usage'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[show usage]' \
    '1: :->cmd' \
    '*:: :->args'

  case $state in
    cmd)
      _describe -t commands 'cid command' cmds
      ;;
    args)
      case ${line[1]} in
        show)
          _cid_files
          ;;
        env)
          _cid_envvars
          ;;
        settings)
          _arguments \
            '(-g --global)'{-g,--global}'[target the shared baseline rule list]' \
            '(-C --dir --project)'{-C,--dir,--project}'[select project by directory]:dir:_files -/' \
            '1: :->sub' \
            '*:: :->rest'
          case $state in
            sub)
              local -a subs
              subs=(
                'trust:stop flagging a permissions.allow rule'
                'untrust:flag a rule again'
                'forget:drop the approved risk profile for this project'
                'ls:show what the project settings grant'
              )
              _describe -t subcommands 'settings action' subs
              _files -/
              ;;
            rest)
              [[ ${line[1]} == untrust ]] && _cid_rules
              ;;
          esac
          ;;
        project|domains|splice|containers)
          # Second word: for domains/splice/containers, the add/rm/ls verbs; then
          # flags/entries. `project` just takes a directory.
          if [[ ${line[1]} == project ]]; then
            _files -/
          else
            local kind=${line[1]}
            local -a for_flag=()
            [[ $kind == domains ]] && for_flag=('--for[expire the entry after a duration, e.g. 15m/2h/1d]:duration:')
            _arguments \
              '(-g --global)'{-g,--global}'[target the shared baseline list]' \
              '(-C --dir --project)'{-C,--dir,--project}'[select project by directory]:dir:_files -/' \
              "${for_flag[@]}" \
              '1: :->sub' \
              '*:: :->rest'
            case $state in
              sub)
                local -a subs
                if [[ $kind == domains ]]; then
                  subs=(
                    'add:add host(s) to the allowlist'
                    'rm:remove host(s) from the allowlist'
                    'prune:drop expired --for entries'
                    'ls:show the effective allowlist'
                  )
                elif [[ $kind == splice ]]; then
                  subs=(
                    'add:stop decrypting host(s)'
                    'rm:decrypt host(s) again'
                    'ls:show the effective splice list'
                  )
                else
                  subs=(
                    'add:allow container(s) for the docker bridge'
                    'rm:remove container(s) from the allowlist'
                    'ls:show the effective container allowlist'
                  )
                fi
                _describe -t subcommands "$kind action" subs
                _files -/
                ;;
              rest)
                if [[ ${line[1]} == rm ]]; then
                  case $kind in
                    domains) _cid_hosts ;;
                    splice)  _cid_spliced ;;
                    *)       _cid_containers ;;
                  esac
                fi
                ;;
            esac
          fi
          ;;
      esac
      ;;
  esac
}

_cid "$@"
